# Endereço do host Proxmox (sem https://, sem porta)
PROXMOX_HOST=192.168.1.10
PROXMOX_PORT=8006

# API Token: crie em Datacenter > Permissions > API Tokens
# Formato do ID: usuario@realm!nome-do-token
PROXMOX_TOKEN_ID=root@pam!pwa-control
PROXMOX_TOKEN_SECRET=cole-o-uuid-do-token-aqui

# true se o certificado do Proxmox for self-signed (padrão em homelab)
PROXMOX_INSECURE_SSL=true

# Porta em que este servidor Node vai rodar
PORT=3000

# Opcional: chave de acesso extra exigida no header x-app-key.
# Deixe vazio para desativar (recomendado deixar a proteção a cargo
# do Cloudflare Access / Zero Trust na frente do túnel).
APP_ACCESS_KEY=
